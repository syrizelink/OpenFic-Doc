{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "almond",
  "name": "OpenFic",
  "colors": {
    "primary": "#000000",
    "light": "#FFFFFF",
    "dark": "#000000"
  },
  "favicon": {
    "light": "/images/light.svg",
    "dark": "/images/dark.svg"
  },
  "navigation": {
    "pages": [
      "index",
      {
        "group": "安装",
        "pages": [
          "installation/docker",
          "installation/python",
          "installation/desktop"
        ],
        "expanded": true
      },
      {
        "group": "快速入门",
        "expanded": true,
        "pages": [
          "getting_started/provider",
          "getting_started/model",
          "untitled-page-2"
        ]
      },
      {
        "group": "功能",
        "pages": [
          "untitled-page-3"
        ]
      }
    ]
  },
  "logo": {
    "light": "/images/brand-light.svg",
    "dark": "/images/brand-dark.svg",
    "href": "https://github.com/syrizelink/OpenFic"
  },
  "navbar": {
    "links": [
      {
        "href": "https://github.com/syrizelink/OpenFic",
        "label": "Github"
      }
    ]
  },
  "contextual": {
    "options": [
      "copy",
      "view",
      "download-pdf",
      "chatgpt",
      "claude",
      "grok",
      "aistudio"
    ]
  },
  "background": {
    "color": {
      "dark": "#111111"
    }
  },
  "appearance": {
    "strict": false
  },
  "styling": {
    "eyebrows": "breadcrumbs",
    "latex": true
  },
  "metadata": {
    "timestamp": false
  },
  "markdown": {
    "schema": true
  },
  "fonts": {
    "family": "Noto Serif SC"
  },
  "banner": {
    "content": "🔔本文档仍在编写中，一些内容可能随时发生变化，请以实际功能为准",
    "dismissible": true,
    "type": "info"
  }
}
