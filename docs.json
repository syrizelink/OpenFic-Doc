{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "almond",
  "name": "OpenFic",
  "colors": {
    "primary": "#000000",
    "light": "#FFFFFF",
    "dark": "#000000"
  },
  "favicon": {
    "light": "/images/light.svg",
    "dark": "/images/dark.svg"
  },
  "navigation": {
    "pages": [
      "index",
      {
        "group": "安装",
        "pages": [
          "installation/docker",
          "installation/python",
          "installation/desktop"
        ]
      },
      {
        "group": "Getting Started",
        "pages": [
          "int",
          "quickstart"
        ]
      }
    ]
  },
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg"
  },
  "navbar": {
    "links": [],
    "primary": {
      "type": "button",
      "label": "Dashboard",
      "href": "https://app.mintlify.com"
    }
  },
  "contextual": {
    "options": [
      "copy",
      "view",
      "download-pdf",
      "chatgpt",
      "claude",
      "grok",
      "aistudio"
    ]
  },
  "footer": {
    "socials": {
      "github": "https://github.com/syrizelink/OpenFic"
    }
  },
  "background": {
    "color": {
      "dark": "#111111"
    }
  },
  "appearance": {
    "strict": false
  },
  "styling": {
    "eyebrows": "breadcrumbs",
    "latex": true
  },
  "metadata": {
    "timestamp": true
  },
  "markdown": {
    "schema": true
  },
  "fonts": {
    "family": "Noto Serif SC"
  }
}
