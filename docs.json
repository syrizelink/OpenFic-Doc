{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "almond",
  "name": "Mintlify Starter Kit",
  "colors": {
    "primary": "#000000",
    "light": "#FFFFFF",
    "dark": "#000000"
  },
  "favicon": "/favicon.svg",
  "navigation": {
    "pages": [
      {
        "group": "Getting Started",
        "pages": [
          "index",
          "quickstart"
        ]
      },
      "introduction",
      {
        "group": "安装",
        "pages": [
          "installation/docker",
          "installation/python",
          "installation/desktop"
        ]
      },
      {
        "group": "Getting Started",
        "pages": [
          "index",
          "quickstart"
        ]
      }
    ],
    "global": {
      "anchors": [
        {
          "anchor": "Documentation",
          "href": "https://mintlify.com/docs",
          "icon": "book-open-cover"
        },
        {
          "anchor": "Blog",
          "href": "https://mintlify.com/blog",
          "icon": "newspaper"
        }
      ]
    }
  },
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg"
  },
  "navbar": {
    "links": [],
    "primary": {
      "type": "button",
      "label": "Dashboard",
      "href": "https://app.mintlify.com"
    }
  },
  "contextual": {
    "options": [
      "copy",
      "view",
      "download-pdf"
    ]
  },
  "footer": {
    "socials": {
      "github": "https://github.com/syrizelink/OpenFic"
    }
  },
  "background": {
    "color": {
      "dark": "#111111"
    }
  },
  "appearance": {
    "strict": false
  },
  "styling": {
    "eyebrows": "breadcrumbs",
    "latex": true
  },
  "metadata": {
    "timestamp": true
  },
  "markdown": {
    "schema": true
  }
}
